{
  "name": "musicrepeat",
  "version": "1.5.4",
  "description": "カフェBGMプレイヤー - フォルダー内の音楽を自動調整して流し続ける",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.musicrepeat.app",
    "productName": "MusicRepeat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "remote/**/*",
      "signage/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "unpackDirName": "MusicRepeatPortableCache"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "MusicRepeat-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.23.0"
  }
}
